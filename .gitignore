# Python bytecode
__pycache__/
*.py[cod]

# Test cache
.pytest_cache/

# Virtual environments
venv/
.venv/

# PyInstaller output (keep the project's own spec file)
build/
dist/
*.spec
!packaging/LocalAIAssistant.spec

# Logs
logs/
*.log

# Local app data when LAA_DATA_DIR points inside the repo (default is %LOCALAPPDATA%)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Captures from `python main.py --screenshot PATH` saved in the repo root
# (docs/screenshots/ is documentation and stays tracked)
/*.png
